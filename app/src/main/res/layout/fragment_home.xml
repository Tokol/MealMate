<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Weekly Meal Plan Title with Add Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mealPlanTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Weekly Meal Plan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_weight="1" />

        <!-- Add Meal Plan Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/addMealPlanIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Add Meal Plan"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Horizontal RecyclerView for Weekly Meal Plan -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mealPlanRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:scrollbars="horizontal" />

    <!-- Favorite Stores Section Title with Add Icon & View Map Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/favStoresTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Favorite Stores"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_weight="1" />

        <!-- Add Favorite Store Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/addFavStoreIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Add Favorite Store"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- View All Stores on Map Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/viewMapIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:tint="@color/secondary"
            android:src="@drawable/ic_map"
            android:contentDescription="View Stores on Map"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Favorite Stores RecyclerView inside a MaterialCardView -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favStoresRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action Button for Shopping Cart -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addStoreFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_cart"
        android:contentDescription="Shopping Cart"
        app:backgroundTint="?attr/colorPrimary"
        android:layout_gravity="end|bottom"
        android:layout_margin="24dp" />

</LinearLayout>
